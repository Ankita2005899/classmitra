# Copy this file to ".env" and fill in your values. NEVER commit ".env".
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://ankita2005899.github.io
# Free key: https://aistudio.google.com/apikey  (needed from Phase 2)
GEMINI_API_KEY=
# MySQL from Workbench. If your password has @ # / write it as %40 %23 %2F.
# Leave empty to use a local SQLite file instead.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/classmitra
# Any long random text. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Firebase project id for Google and GitHub login (Project settings > General).
FIREBASE_PROJECT_ID=
